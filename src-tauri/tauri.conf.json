{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "poolr",
  "version": "0.4.0",
  "identifier": "com.poolr.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "poolr",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "category": "Science",
    "shortDescription": "Systematic Review & Meta-Analysis",
    "longDescription": "poolr is a no-code desktop app for systematic reviews and meta-analyses — PICO, search, screening, extraction, risk of bias, meta-analysis, and PRISMA export."
  }
}
