{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "poolr",
  "version": "0.6.2",
  "identifier": "com.poolr.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "poolr",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "rpm"],
    "resources": {
      "resources/engine": "engine"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "publisher": "M. Haris Awan",
    "copyright": "© 2026 M. Haris Awan (Proprietary License)",
    "category": "Education",
    "shortDescription": "Proprietary Systematic Review & Meta-Analysis desktop app (PRISMA 2020)",
    "longDescription": "poolr is a proprietary desktop app for systematic reviews and meta-analyses."
  }
}
