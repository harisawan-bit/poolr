# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure LF for code files
*.cs text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.csproj text eol=lf
*.cff text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
